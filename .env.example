# ============================================================
# EnterpriseERP — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ─── Core Django ──────────────────────────────────────────────────────────
SECRET_KEY=your-very-long-random-secret-key-50-chars-minimum-change-me
DEBUG=False
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# ─── Database (PostgreSQL) ───────────────────────────────────────────────
DB_NAME=erp_db
DB_USER=erp_user
DB_PASSWORD=strongpassword123
DB_HOST=db
DB_PORT=5432

# ─── Cache / Queue (Redis) ───────────────────────────────────────────────
REDIS_URL=redis://:redispass@redis:6379/0
REDIS_PASSWORD=redispass
CELERY_BROKER_URL=redis://:redispass@redis:6379/1
CELERY_RESULT_BACKEND=redis://:redispass@redis:6379/2

# ─── Email (SMTP) ────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=rishabhkhatri192@gmail.com
EMAIL_HOST_PASSWORD=fikh boof aiod exbj
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ─── Superuser (auto-created on first boot) ──────────────────────────────
DJANGO_SUPERUSER_EMAIL=admin@yourdomain.com
DJANGO_SUPERUSER_PASSWORD=Admin@12345

# ─── ERP Settings ────────────────────────────────────────────────────────
COMPANY_NAME=EnterpriseERP
DEFAULT_CURRENCY=USD
FISCAL_YEAR_START=01-01
TIME_ZONE=UTC
ENABLE_2FA=True
AUDIT_LOG_RETENTION_DAYS=365
LOW_STOCK_THRESHOLD=10
INVOICE_PREFIX=INV
PO_PREFIX=PO
SO_PREFIX=SO
PAYSLIP_PREFIX=PAY

# ─── Gunicorn ─────────────────────────────────────────────────────────────
GUNICORN_WORKERS=4
GUNICORN_WORKER_CLASS=sync
GUNICORN_CONNECTIONS=1000
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_LOG_LEVEL=info

# ─── Celery ───────────────────────────────────────────────────────────────
CELERY_CONCURRENCY=4
CELERY_LOG_LEVEL=info

# ─── CORS ─────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:,127.0.0.2

# ─── Optional: AWS S3 (for file storage) ────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
# USE_S3=False

# ─── Optional: Sentry (for error tracking) ──────────────────────────────
# SENTRY_DSN=

# ─── Load initial fixtures on first boot ────────────────────────────────
LOAD_FIXTURES=false
